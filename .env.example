# TMDB v4 read access token (used only by build scripts / GitHub Actions)
TMDB_TOKEN=

# optional: site base url used for canonical / sitemap / sitemap links
SITE_URL=

# optional: tuning knobs (defaults shown)
# MAX_SHOWS=280
# GLOBAL_WINDOW_PAGES=10
# STRIP_MAX_DAYS=18
# TMDB_GAP_MS=250
# TMDB_CACHE_TTL_HOURS=2
# TVMAZE_SUPPLEMENT=off via TVMAZE_OFF=1; pacing + cache knobs
# TVMAZE_OFF=
# TVMAZE_GAP_MS=550
# TVMAZE_CACHE_TTL_HOURS=6
